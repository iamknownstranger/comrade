<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network access for Nostr relay connections -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Local network access for Saathi mDNS peer discovery -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Bluetooth mesh: the transport that needs no router at all (a protest,
         a blackout, a mountain). Every device is simultaneously GATT peripheral
         and central, so both ADVERTISE and SCAN are required.

         `neverForLocation` is load-bearing, not boilerplate: without it Android
         treats a BLE scan as a location request and demands ACCESS_FINE_LOCATION,
         which for a privacy-first messenger would mean asking for the user's
         physical location in order to send a message to somebody in the same
         room. Comrade never derives location from a scan result, so it asserts
         that and asks for neither location permission.

         BLUETOOTH/BLUETOOTH_ADMIN are the pre-31 spellings, capped so they are
         not requested on newer releases that replaced them. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Travel tab: where the locals eat, and what this place is.

         COARSE only, and that is the whole permission this feature asks for.
         `comrade_core::travel` rounds whatever fix it is given to a ~150 m
         geohash cell before a coordinate leaves the device, so FINE would be
         asking for precision the app immediately throws away — the same
         argument the BLE entries above make with `neverForLocation`, one step
         further. A guide with a kilometre-wide radius does not need a satellite
         lock, and the tab degrades to "location unavailable" rather than
         nagging when the permission is refused. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <!-- "Hey Comrade" voice assistant: microphone + always-listening service -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Screen sharing during a call (CallManager.startScreenShare). The
         projection itself is granted per-share by the system's own consent
         dialog; from Android 14 it may only *begin* while a foreground service
         declaring the mediaProjection type is already running, which is why
         CallService re-announces itself before capture starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Installs an update the app downloaded itself (UpdateDownloadService →
         UpdateInstaller). Declaring it is not enough: from Android 8 the user
         grants "install unknown apps" to this app once, which is the same
         consent a browser needs to install a sideloaded APK — moved to the app
         that actually knows what the file is. Android still refuses an APK
         signed with a different key than the copy already installed, and that
         refusal is unconditional enforcement rather than a dialog. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Lets the session above ask for USER_ACTION_NOT_REQUIRED, so a self-update
         applies without a confirmation dialog: Comrade's process is replaced and
         a notification offers to reopen it (UpdateInstaller.notifyInstalled).
         An owner decision, taken after the dialog turned out to be the part that
         silently failed to appear.

         A normal permission — granted at install, no runtime prompt — and it
         grants nothing on its own. Whether the dialog is actually skipped is the
         platform's call and can differ by device, by OEM policy, and by which
         installer holds update ownership (Android 14+); when it says no the
         session answers STATUS_PENDING_USER_ACTION and UpdateInstallActivity
         shows the dialog exactly as before. Nothing may assume which happened. -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- Lets UpdateCheckJob's daily release check be a *persisted* job, so it
         survives a reboot. Nothing here runs at boot: this app declares no
         BOOT_COMPLETED receiver, and the permission's only effect is that
         JobInfo.setPersisted(true) stops throwing. Without it the check would
         stop at the first restart, which for a phone that reboots weekly is most
         of the time. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- CallService: keeps an in-progress call's process alive while the app
         is backgrounded. Required alongside the matching foregroundServiceType
         on Android 14+ (see CallService/the <service> entry below); video
         calls additionally use the camera type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- RelayConnectionService: keeps the relay connection (and therefore
         notification delivery) alive while the vault is unlocked but no
         Activity is visible — see its doc comment for the security boundary.
         "dataSync" is the closest stock foregroundServiceType to "maintaining
         a network connection and delivering the data it carries". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Watch/listen together keeps playing while the app is backgrounded, so
         putting the phone down does not stop the film for both people. Required
         alongside the matching foregroundServiceType on Android 14+ (see
         together/TogetherService). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Reads this device's own audio library so watch/listen together can open
         the copy you already have — `/play kun faya kun`, and the auto-open when
         somebody invites you (LibraryResolver, TogetherManager.onInvited). That
         is the whole of Antra's claim that the answer to "how do we both have
         this file" is "you already did": nothing is downloaded and no service is
         authenticated against, so without a read of MediaStore there is nothing
         to match against and the lookup can only ever answer "not here".

         A runtime permission, so declaring it grants nothing: MediaLibraryAccess
         decides when to ask, and it asks at the moment somebody actually names a
         song rather than at startup. Denied is a first-class answer — the file
         picker needs no permission at all (SAF grants per file), so every route
         still works and the composer says Comrade was not allowed to look rather
         than that the track is absent.

         Split at Tiramisu because READ_EXTERNAL_STORAGE stopped granting media
         access there; capped at 32 so a modern install is not asked for the
         broad old permission it would ignore. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ProximityScreenControl (CallScreen.kt) holds a PROXIMITY_SCREEN_OFF_WAKE_LOCK
         for the duration of a call; CaptureManager holds a PARTIAL_WAKE_LOCK
         for the duration of a helmet-cam recording, so the CPU cannot suspend
         out from under it once the screen goes off. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Helmet-cam recording (CaptureManager/CaptureService): camera +
         microphone capture, tagged "camera" and "microphone" on the
         foreground-service declaration below. CAMERA and RECORD_AUDIO are
         already declared above for calls. On API 26-28 only, writing a
         gallery-destination recording into the public DCIM/Camera folder
         needs this — API 29+ inserts through MediaStore instead, which needs
         no storage permission at all (see CaptureSink). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Voice/video calls (WebRTC): camera capture for video calls and in-call
         audio routing (earpiece/speaker/Bluetooth/wired headset — see
         CallManager's AudioRoute). RECORD_AUDIO above already covers the
         microphone. The camera is declared optional so the app still installs
         on camera-less devices — voice calls don't need it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bluetooth call-audio routing on API 31+: AudioManager.setCommunicationDevice
         to a TYPE_BLUETOOTH_SCO device requires this even though CallManager
         never touches android.bluetooth.* directly. Requested at runtime only
         when the user actually selects the Bluetooth route (CallManager /
         AudioRouteButton) — declaring it here just makes that request
         possible; it does not grant it. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Ringing/vibrating for an incoming call (Ringer.kt). Normal permission —
         no runtime prompt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Required for Notifier.notifyIncomingCall's CallStyle notification: on
         the callee side there is no foreground service yet while merely
         ringing (CallService only starts once the call is accepted/placed),
         so the fullScreenIntent it already sets is the only one of
         CallStyle's three allowed conditions available at ring time. Without
         this declared, the platform silently treats fullScreenIntent as
         absent too, and NotificationManagerCompat.notify throws
         IllegalArgumentException instead of posting. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- The attention mirror (docs/ATTENTION.md phase 1): reads how long the
         screen was on, how often it was picked up, and time in the apps the
         *user themself* tagged as scroll traps — reduced to three integers a
         day and stored in the encrypted vault (see UsageMirror, which is where
         the raw events are dropped).

         This is a special-access grant, not a runtime permission: declaring it
         here grants nothing at all. The user must visit a system settings
         screen, which the app only sends them to from an explainer that states
         what is read and that it never leaves the device. Everything else in
         the attention pillar — focus sessions, the reader, quiet hours, the
         gentle stop — works with this never granted. `tools:ignore` because
         lint flags the permission as not-for-third-party-apps; it is
         nonetheless the only documented API for showing someone their own
         screen time, and it is user-granted per app. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Package visibility (API 30+): CaptureScreen's "use my camera app"
         switch hands a one-off shot to whatever the phone's own default
         camera app is (Google Camera on a Pixel), via
         SystemCameraHandoff.installedFor/prepare. Without declaring these two
         intents, PackageManager.queryIntentActivities silently returns an
         empty list for every other app's manifest on API 30+, so
         installedFor always answers false, CameraApp.handoff reports
         Fallback.NoSystemCameraInstalled on every such device regardless of
         what is actually on it, and the feature disappears without a single
         exception anywhere — see SystemCameraHandoff's class doc. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- allowBackup=false: the encrypted vault must not leave the device via
         adb/cloud backup — an exported copy is an offline brute-force target.
         hasFragileUserData=true is unrelated to that: it just opts into the
         platform's "keep app data" uninstall dialog (Android 10+) so a
         reinstall doesn't silently wipe the vault/key material and chat
         history the user never asked to delete. -->
    <application
        android:name=".ComradeApplication"
        android:allowBackup="false"
        android:hasFragileUserData="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Comrade">

        <!-- supportsPictureInPicture: a live video call floats into a PiP
             window when you leave the app or tap the in-call chat button
             (MainActivity.onUserLeaveHint / PipController). resizeableActivity
             is its prerequisite, and configChanges keeps the Activity — and so
             the live PeerConnection — alive across the resize into/out of that
             window rather than recreating it mid-call. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The way into the reading library from every other app: share
                 an article's text (or its link plus text) out of any feed and
                 it is offered — never silently saved — to Long reads. Text
                 only, deliberately: files and images are the attachment
                 pipeline's business, not the reader's. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Handles the Decline/Hang Up actions on the call notifications'
             CallStyle (Notifier.notifyIncomingCall, CallService). Not
             exported: only this app's own PendingIntents ever invoke it. -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />

        <!-- Keeps the process alive with an ongoing-call notification for the
             duration of a call's live media — see CallService's doc comment.
             foregroundServiceType declares the maximum this service may use;
             each startForeground() call passes the subset it actually needs
             (microphone alone for voice, +camera for video). -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone|mediaProjection" />

        <!-- Helmet-cam recording: keeps the process (and, since Android 11,
             camera access itself) alive for the length of a recording,
             including with the screen off — see CaptureService's doc
             comment. Always uses both types; unlike CallService there is no
             audio-only variant of this feature. -->
        <service
            android:name=".capture.CaptureService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />

        <!-- Always-listening "Hey Comrade" wake-word foreground service -->
        <service
            android:name=".voice.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Keeps the relay connection alive while the vault is unlocked but
             the app is backgrounded — see RelayConnectionService's doc
             comment for scope and the security boundary. -->
        <service
            android:name=".RelayConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Keeps a watch-together session playing while the app is
             backgrounded. Framework MediaSession, no media3 dependency — see
             TogetherService's doc comment. -->
        <service
            android:name=".together.TogetherService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|mediaProjection" />

        <!-- Watch/listen together against a player Comrade does not own
             (docs/TOGETHER.md §13). Declared purely so the *component* exists
             and can be enabled: MediaSessionManager.getActiveSessions only
             answers a caller that names an enabled notification listener, and
             that API is the whole reason this is here. The class overrides
             nothing — no notification is read, kept or posted through it.

             A special access, not a runtime permission: there is no dialog and
             no requestPermissions for it. The user grants it in system settings,
             which is why MediaSessionAccess reads the secure setting to find out
             rather than calling checkSelfPermission — that would answer
             "granted" for this declaration alone and the feature would silently
             find nothing.

             exported + BIND_NOTIFICATION_LISTENER_SERVICE is the same shape
             ComradeInteractionService uses above: the intent-filter is how the
             system finds it, and the permission is what makes sure only the
             system may bind it. Confirmed *not* on Play's restricted-permissions
             list (unlike the Accessibility API, which is gated), so no
             declaration form — which is not the same as approved, and general
             policy still applies. -->
        <service
            android:name=".together.MediaSessionListenerService"
            android:exported="true"
            android:label="@string/together_follow_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Downloads an on-device model (speech / companion) in the
             background with progress in the notification bar, so the transfer
             survives the app being backgrounded — see ModelDownloadService. -->
        <service
            android:name=".model.ModelDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Downloads the update APK in the background with progress in the
             notification bar, then offers to install it — see
             UpdateDownloadService. Reads the release from UpdateChecker's own
             state rather than from an intent extra, so no caller can name a URL
             for it to fetch. -->
        <service
            android:name=".update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Streams the downloaded APK into the PackageInstaller session with
             progress in the shade. A foreground service rather than a bare worker
             thread because the copy takes seconds a user waits through: it used to
             happen invisibly, behind an Activity that covered the app without
             drawing anything, which is what "I clicked install and it stopped
             responding" was. Started from a resumed Activity, so the Android 12+
             background-start restriction never applies. Reads what to install from
             UpdateDownloads, never from an intent extra. See UpdateInstallService. -->
        <service
            android:name=".update.UpdateInstallService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Asks GitHub once a day whether a newer Comrade exists, with the app
             closed, and posts the notification that says so — the only situation
             in which that notification is worth anything. Persisted, so it
             survives a reboot; taken out of the queue when auto-check is switched
             off. See UpdateCheckJob.

             BIND_JOB_SERVICE is required by the platform and is what makes this
             safe to leave unexported-but-bindable: only the system may bind it. -->
        <service
            android:name=".update.UpdateCheckJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Both halves of the install: the "ready to install" notification tap,
             and the PackageInstaller session's status callbacks. An Activity
             rather than a receiver, and it is not a stylistic choice — the
             session answers STATUS_PENDING_USER_ACTION with an Intent the app
             must start, and a receiver may not reliably start one (notification
             trampolines are blocked from Android 12, background activity starts
             from Android 10) and fails at it silently. See
             UpdateInstallActivity's doc comment.

             Draws nothing: translucent, no content view. Its own taskAffinity +
             excludeFromRecents keep it out of the app's back stack and out of
             recents; singleTop lets the session's callback reach the instance
             that is already up. configChanges because a rotation mid-install
             must not restart it. Not exported: only this app's own
             PendingIntents and the platform's session callback reach it. -->
        <activity
            android:name=".update.UpdateInstallActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="${applicationId}.updateinstall"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|locale|layoutDirection|fontScale|density|uiMode"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Assist app: the assist gesture (long-press power) opens Comrade -->
        <service
            android:name=".voice.ComradeInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
        </service>

        <service
            android:name=".voice.ComradeInteractionSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Offline recognition service backing the assist registration -->
        <service
            android:name=".voice.ComradeRecognitionService"
            android:exported="true"
            android:permission="android.permission.RECORD_AUDIO">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <!-- Hands a decrypted media attachment to another app (e.g. opening a
             video/document externally) as a content:// URI instead of a raw
             file:// path, which Android has blocked cross-app since N. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
